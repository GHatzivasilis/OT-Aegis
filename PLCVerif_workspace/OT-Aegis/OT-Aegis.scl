FUNCTION_BLOCK FB_AI_SafetySupervisor
VAR_INPUT
    ShieldEnable        : BOOL;
    ShieldValid         : BOOL;
    ShieldSeqId         : DINT;
    ShieldHeartbeat     : DINT;
    ShieldDecisionCode  : INT;   // 1=ALLOW, 2=DOWNGRADE, 3=FALLBACK, 4=BLOCK
    ShieldRiskScore     : INT;   // 0..100
    ShieldPumpCmd_x10   : INT;   // pump speed %, scaled by 10
    ShieldValveOpenCmd  : BOOL;
    ShieldFallbackReq   : BOOL;
    ShieldSafeStopReq   : BOOL;

    TankLevel_x10       : INT;   // %, scaled by 10
    Pressure_x100       : INT;   // bar, scaled by 100
    FlowRate_x10        : INT;   // m3/h, scaled by 10

    EmergencyStop       : BOOL;
    MaintenanceMode     : BOOL;
    ManualOverride      : BOOL;
END_VAR

VAR_OUTPUT
    PumpSpeedOut_x10    : INT;
    ValveOpenOut        : BOOL;

    UseShieldControl    : BOOL;
    UseFallbackControl  : BOOL;
    FailSafeActive      : BOOL;
    Alarm               : BOOL;

    HeartbeatOK         : BOOL;
    SequenceOK          : BOOL;
    BoundsOK            : BOOL;
    RiskOK              : BOOL;
    ProcessLogicOK      : BOOL;
    ModeOK              : BOOL;
    ShieldDecisionOK    : BOOL;
    SafetyOK            : BOOL;
END_VAR

VAR
    LastSeqId           : DINT;
    LastHeartbeat       : DINT;
    HeartbeatChanged    : BOOL;
END_VAR

VAR CONSTANT
    DECISION_ALLOW      : INT := 1;
    DECISION_DOWNGRADE  : INT := 2;
    DECISION_FALLBACK   : INT := 3;
    DECISION_BLOCK      : INT := 4;

    MIN_PUMP_X10        : INT := 0;
    MAX_PUMP_X10        : INT := 800;
    FALLBACK_PUMP_X10   : INT := 300;

    MIN_TANK_X10        : INT := 50;
    MAX_TANK_X10        : INT := 950;
    MAX_PRESSURE_X100   : INT := 800;
    MIN_FLOW_X10        : INT := 1;

    MAX_RISK            : INT := 70;
END_VAR

BEGIN
    // Default fail-safe outputs.
    PumpSpeedOut_x10 := 0;
    ValveOpenOut := FALSE;

    UseShieldControl := FALSE;
    UseFallbackControl := FALSE;
    FailSafeActive := TRUE;
    Alarm := TRUE;

    HeartbeatOK := FALSE;
    SequenceOK := FALSE;
    BoundsOK := FALSE;
    RiskOK := FALSE;
    ProcessLogicOK := FALSE;
    ModeOK := FALSE;
    ShieldDecisionOK := FALSE;
    SafetyOK := FALSE;

    // Heartbeat and sequence checks.
    HeartbeatChanged := ShieldHeartbeat <> LastHeartbeat;

    IF HeartbeatChanged THEN
        HeartbeatOK := TRUE;
    ELSE
        HeartbeatOK := FALSE;
    END_IF;

    IF ShieldSeqId > LastSeqId THEN
        SequenceOK := TRUE;
    ELSE
        SequenceOK := FALSE;
    END_IF;

    // Operating mode.
    ModeOK := ShieldEnable AND
              NOT EmergencyStop AND
              NOT MaintenanceMode AND
              NOT ManualOverride;

    // Shield decision acceptance.
    ShieldDecisionOK :=
        ShieldValid AND
        (
            (ShieldDecisionCode = DECISION_ALLOW) OR
            (ShieldDecisionCode = DECISION_DOWNGRADE)
        );

    // Hard bounds.
    BoundsOK :=
        (ShieldPumpCmd_x10 >= MIN_PUMP_X10) AND
        (ShieldPumpCmd_x10 <= MAX_PUMP_X10) AND
        (TankLevel_x10 >= MIN_TANK_X10) AND
        (TankLevel_x10 <= MAX_TANK_X10) AND
        (Pressure_x100 <= MAX_PRESSURE_X100);

    // Risk threshold.
    RiskOK := ShieldRiskScore <= MAX_RISK;

    // Process logic.
    ProcessLogicOK := TRUE;

    IF (ShieldPumpCmd_x10 > 0) AND (NOT ShieldValveOpenCmd) THEN
        ProcessLogicOK := FALSE;
    END_IF;

    IF (Pressure_x100 > 720) AND (FlowRate_x10 < MIN_FLOW_X10) THEN
        ProcessLogicOK := FALSE;
    END_IF;

    IF (TankLevel_x10 > 900) AND (ShieldPumpCmd_x10 > 200) THEN
        ProcessLogicOK := FALSE;
    END_IF;

    // Overall safety decision.
    SafetyOK :=
        HeartbeatOK AND
        SequenceOK AND
        ModeOK AND
        ShieldDecisionOK AND
        BoundsOK AND
        RiskOK AND
        ProcessLogicOK AND
        NOT ShieldFallbackReq AND
        NOT ShieldSafeStopReq;

    // Priority-ordered deterministic enforcement.
    IF EmergencyStop THEN
        PumpSpeedOut_x10 := 0;
        ValveOpenOut := FALSE;
        UseShieldControl := FALSE;
        UseFallbackControl := FALSE;
        FailSafeActive := TRUE;
        Alarm := TRUE;

    ELSIF ShieldSafeStopReq OR (ShieldDecisionCode = DECISION_BLOCK) THEN
        PumpSpeedOut_x10 := 0;
        ValveOpenOut := FALSE;
        UseShieldControl := FALSE;
        UseFallbackControl := FALSE;
        FailSafeActive := TRUE;
        Alarm := TRUE;

    ELSIF SafetyOK THEN
        PumpSpeedOut_x10 := ShieldPumpCmd_x10;
        ValveOpenOut := ShieldValveOpenCmd;
        UseShieldControl := TRUE;
        UseFallbackControl := FALSE;
        FailSafeActive := FALSE;
        Alarm := FALSE;

    ELSIF ModeOK AND (ShieldFallbackReq OR (ShieldDecisionCode = DECISION_FALLBACK)) THEN
        PumpSpeedOut_x10 := FALLBACK_PUMP_X10;
        ValveOpenOut := TRUE;
        UseShieldControl := FALSE;
        UseFallbackControl := TRUE;
        FailSafeActive := FALSE;
        Alarm := TRUE;

    ELSE
        PumpSpeedOut_x10 := 0;
        ValveOpenOut := FALSE;
        UseShieldControl := FALSE;
        UseFallbackControl := FALSE;
        FailSafeActive := TRUE;
        Alarm := TRUE;
    END_IF;

    //#ASSERT (EmergencyStop = FALSE OR FailSafeActive = TRUE) : assert1
	//#ASSERT (EmergencyStop = FALSE OR PumpSpeedOut_x10 = 0) : assert2
	//#ASSERT (EmergencyStop = FALSE OR ValveOpenOut = FALSE) : assert3
	//#ASSERT (PumpSpeedOut_x10 <= 800) : assert4
	//#ASSERT (PumpSpeedOut_x10 <= 0 OR ValveOpenOut = TRUE) : assert5
	//#ASSERT (ShieldSafeStopReq = FALSE OR FailSafeActive = TRUE) : assert6
	//#ASSERT (ShieldDecisionCode <> 4 OR FailSafeActive = TRUE) : assert7
	//#ASSERT (ShieldValid = TRUE OR UseShieldControl = FALSE) : assert8
	//#ASSERT (EmergencyStop = FALSE OR UseShieldControl = FALSE) : assert10
	//#ASSERT (FailSafeActive = FALSE OR PumpSpeedOut_x10 = 0) : assert11
	//#ASSERT (FailSafeActive = FALSE OR ValveOpenOut = FALSE) : assert12
	//#ASSERT (UseShieldControl = FALSE OR FailSafeActive = FALSE) : assert13
	//#ASSERT (UseShieldControl = FALSE OR UseFallbackControl = FALSE) : assert14

    // Store state for next scan.
    LastSeqId := ShieldSeqId;
    LastHeartbeat := ShieldHeartbeat;
END_FUNCTION_BLOCK